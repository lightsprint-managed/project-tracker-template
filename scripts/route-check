#!/usr/bin/env bash
# Request every main route of the running app and fail on any non-2xx.
#
#   BASE_URL=http://localhost:3000 ./scripts/route-check
#
# Routes are listed in scripts/routes.txt (one path per line).
set -euo pipefail

BASE_URL="${BASE_URL:-http://localhost:3000}"
ROUTES_FILE="$(dirname "$0")/routes.txt"
failed=0

while IFS= read -r route || [ -n "$route" ]; do
  case "$route" in ''|'#'*) continue ;; esac
  status="$(curl -s -o /dev/null -w '%{http_code}' --max-time 120 "$BASE_URL$route" || echo 000)"
  if [ "${status:0:1}" = "2" ]; then
    echo "ok   $status $route"
  else
    echo "FAIL $status $route"
    failed=1
  fi
done < "$ROUTES_FILE"

exit "$failed"
